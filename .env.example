# Public Google Analytics measurement ID used by the client bundle. Not a secret.
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Optional server-side override. Vercel Production is enabled automatically;
# Preview and local environments are disabled unless this is exactly "true".
GA4_ENABLED="false"

# Server-only credentials for the 30-day popular-writing order. Never prefix
# these values with NEXT_PUBLIC_ and only configure them in Production.
GA4_PROPERTY_ID="123456789"
GA4_CLIENT_EMAIL="analytics-reader@example-project.iam.gserviceaccount.com"
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
