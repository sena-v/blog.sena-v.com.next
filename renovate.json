{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 6am on monday"],
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "branchConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Automatically merge low-risk patch and digest updates",
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Group non-major npm updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor"],
      "groupName": "non-major npm dependencies"
    },
    {
      "description": "Review breaking upgrades explicitly",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Keep GitHub Actions updates together",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ]
}
