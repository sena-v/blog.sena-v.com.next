{
  "name": "next-markdown-blog",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "next build",
    "build:bookmarklet": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/utils/thread-to-md/thread-to-md.js",
    "check:bookmarklet": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/utils/thread-to-md/thread-to-md.js --check",
    "check:links": "node scripts/check-links.mjs",
    "check:links:external": "CHECK_EXTERNAL_LINKS=1 node scripts/check-links.mjs",
    "ci": "npm run lint && npm run typecheck && npm run test:unit && npm run check:links && npm run check:bookmarklet && npm run build",
    "clean-up-branch": "git checkout main && git pull && git branch --merged main | grep -v -e main | xargs -I{} git branch -d {}",
    "dev": "next dev",
    "e2e:playwright": "npx playwright test",
    "format": "prettier --write --log-level silent . ",
    "lint": "eslint . --max-warnings=0",
    "start": "next start",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/analytics/ga4.test.ts src/lib/analytics/popular-writings.test.ts src/lib/article-images.test.ts src/lib/content.test.ts src/lib/markdown-headings.test.ts",
    "typecheck": "tsc --incremental false"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "sharp": "0.35.5",
    "three": "0.186.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "picomatch": "^4.0.7",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "mdast-util-to-hast": "13.2.1",
    "postcss": "8.5.31",
    "sharp": "0.35.5"
  },
  "allowScripts": {
    "fsevents@2.3.2": true
  }
}
